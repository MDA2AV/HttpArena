{
  "display_name": "plug-cowboy",
  "language": "Elixir",
  "type": "flagship",
  "mode": "standard",
  "completeness": {
    "routing": true,
    "middleware": true,
    "request": true,
    "response": true
  },
  "engine": "Cowboy",
  "description": "Plug on the Cowboy adapter without Phoenix. Routing through Plug.Router, Jason JSON encoding, gzip through the cowboy_compress_h stream handler.",

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>runtime-async=on</Features>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- GenHTTP 11 with the ioxide io_uring engine (PR #860, now merged and published
         to nuget.org). GenHTTP.Engine.Ioxide pulls ioxide + ioxide.tls + Glyph11 +
         GenHTTP.Api/Engine.Shared transitively; GenHTTP.Modules.IoxideFiles pulls
         ioxide.file. The ioxide.* packages are pinned to 0.0.12 to match the version
         the published engine was built against. -->
    <PackageReference Include="GenHTTP.Engine.Ioxide" Version="11.0.0-preview.19" />
    <PackageReference Include="GenHTTP.Modules.IO" Version="11.0.0-preview.19" />
    <PackageReference Include="GenHTTP.Modules.Layouting" Version="11.0.0-preview.19" />
    <PackageReference Include="GenHTTP.Modules.Webservices" Version="11.0.0-preview.19" />
    <PackageReference Include="GenHTTP.Modules.Compression" Version="11.0.0-preview.19" />
    <PackageReference Include="GenHTTP.Modules.IoxideFiles" Version="11.0.0-preview.19" />
    <PackageReference Include="GenHTTP.Modules.Websockets" Version="11.0.0-preview.19" />
    <PackageReference Include="ioxide.pg" Version="0.0.12" />
    <PackageReference Include="ioxide.tls" Version="0.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0-preview.5.26302.115" />
  </ItemGroup>

</Project>

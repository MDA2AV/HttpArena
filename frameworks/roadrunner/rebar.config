{erl_opts, [debug_info]}.

{minimum_otp_vsn, "29"}.

{deps, [
    {roadrunner, "0.10.0"},
    {epgsql, "4.8.0"},
    {ecpool, "0.4.2"},
    % Arizona's template engine renders /fortunes. Pinned to a main commit:
    % the roadrunner-based Arizona is not on Hex yet.
    {arizona, {git, "https://github.com/arizona-framework/arizona.git", {ref, "5a93b397008507b417aed863233612ffcce869c4"}}}
]}.

{relx, [
    {release, {roadrunner_httparena, "0.1.0"},
        %% Arizona is only a template library here: loaded, never started.
        [roadrunner_httparena, ecpool, roadrunner, {arizona, load}]},
    {sys_config, "./config/sys.config"},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [{mode, prod}]}
    ]}
]}.

{erl_opts, [debug_info]}.

{minimum_otp_vsn, "29"}.

{deps, [
    {roadrunner,
        {git, "https://github.com/arizona-framework/roadrunner.git",
            {ref, "6d5e1ef965d677f102c07fe326582f121a8d6540"}}},
    %% Protocol Buffers for roadrunner's gRPC (unary-grpc), with modules
    %% from gpb.
    {roadrunner_grpc_protobuf,
        {git, "https://github.com/arizona-framework/roadrunner_grpc_protobuf.git",
            {ref, "13a22a68adf6d185a2f675bf164b448173f62a1a"}}},
    {epgsql, "4.8.0"},
    {ecpool, "0.4.2"},
    % Arizona's template engine renders /fortunes.
    {arizona, "0.2.0"}
]}.

%% Compiles proto/benchmark.proto (a copy of requests/benchmark.proto) to
%% src/benchmark_pb.{erl,hrl} before the build.
{plugins, [{rebar3_gpb_plugin, "3.0.1"}]}.
{gpb_opts, [
    {i, "proto"},
    {o_erl, "src"},
    {o_hrl, "src"},
    {module_name_suffix, "_pb"},
    maps
]}.
{provider_hooks, [{pre, [{compile, {protobuf, compile}}]}]}.

{relx, [
    {release, {roadrunner_httparena, "0.1.0"},
        %% Arizona is only a template library here: loaded, never started.
        [roadrunner_httparena, ecpool, roadrunner, roadrunner_grpc_protobuf, {arizona, load}]},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [{mode, prod}]}
    ]}
]}.

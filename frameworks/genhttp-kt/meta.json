{
  "display_name": "genhttp-kt",
  "language": "Kotlin",
  "type": "experimental",
  "mode": "standard",
  "completeness": {
    "routing": true,
    "middleware": true,
    "request": true,
    "response": true
  },
  "engine": "genhttp-kt",
  "description": "Kotlin port of the GenHTTP web server on JDK 25, running on its own HTTP/1.1 engine (NIO channels, a coroutine per connection on virtual threads, TLS via the JDK SSLEngine). Implemented with web services and a layout router, JSON via Jackson, Postgres via HikariCP and JDBC.",
  "repo": "https://github.com/Kaliumhexacyanoferrat/genhttp-kt",
  "website": "https://genhttp-kt.genhttp.run/",
  "enabled": true,
  "tests": [
    "baseline",
    "async",
    "latency-1m",
    "latency-10k", "latency-500k-8cpu",
    "pipelined",
    "limited-conn",
    "json-comp",
    "json-tls",
    "static-tls",
    "8gbit",
    "async-db",
    "echo-ws",
    "echo-ws-pipeline",
    "echo-ws-limited"
  ],
  "maintainers": [
    "Kaliumhexacyanoferrat"
  ]
}

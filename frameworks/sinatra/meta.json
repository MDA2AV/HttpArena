{
  "display_name": "sinatra",
  "language": "Ruby",
  "type": "flagship",
  "mode": "standard",
  "completeness": {
    "routing": true,
    "middleware": true,
    "request": true,
    "response": true
  },
  "engine": "puma",
  "description": "Sinatra DSL web framework on Puma, multi-threaded with one worker per CPU core.",
  "repo": "https://github.com/sinatra/sinatra",
  "enabled": true,
  "tests": [
    "baseline", "latency-1m", "latency-10k",
    "pipelined",
    "limited-conn",
    "json-comp",
    "json-tls",
    "echo-10k",
    "async-db",
    "static-tls"
  ],
  "maintainers": ["p8"]
}

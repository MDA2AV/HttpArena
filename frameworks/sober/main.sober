package main

// HttpArena entry for Sober, on std/http/server + std/json + std/tls alone.
// Plain HTTP/1.1 on 0.0.0.0:8080, HTTP/2 with prior knowledge (h2c) on 0.0.0.0:8082 and, when /certs/server.{crt,key}
// (or TLS_CERT / TLS_KEY) can be read, the same routes over TLS 1.3 on 0.0.0.0:8081 (ports overridable by argv).
// Prints "ready <port>" / "h2c-ready <port>" / "tls-ready <port>" once listening.
// Dataset for /json/{count}?m= comes from DATASET_PATH (default /data/dataset.json).
// /async-db reads Postgres through std/pg (a pool of DATABASE_MAX_CONN connections at DATABASE_URL, plaintext on the
// benchmark host's loopback sidecar); without DATABASE_URL, or while the database is unreachable, it answers {"items":[],"count":0}.

import "std/builder"
import "std/compress/flate"
import "std/compress/gzip"
import "std/convert"
import "std/http"
import "std/http/server"
import "std/io"
import "std/iter"
import "std/json"
import "std/net"
import "std/os"
import "std/pg"
import "std/strings"
import "std/task"
import "std/tls"
import "std/url"

func num(s string?) int {
    if s == nil {
        return 0
    }
    v, e := convert.ParseInt(s)
    return if e != nil { 0 } else { v }
}

type Rating struct {
    score int
    count int
}

type Item struct {
    id int
    name string
    category string
    price int
    quantity int
    active bool
    tags []string
    rating Rating
}

type Processed struct {
    id int
    name string
    category string
    price int
    quantity int
    active bool
    tags []string
    rating Rating
    total int
}

type Body struct {
    items []Processed
    count int
}

func load() []Item {
    p := os.Getenv("DATASET_PATH") catch nil
    b := io.ReadFile(if p != nil { p } else { "/data/dataset.json" }) catch return []Item{}
    d := json.Parse(b) catch return []Item{}
    ns := json.Items(d, json.Root(d)) catch return []Item{}
    mut xs := mut []Item{}
    for i <- iter.Range(0, len(ns)) {
        xs = append(xs, json.Decode[Item](d, ns[i]) catch return []Item{})
    }
    return freeze(xs)
}

func items(ds []Item, r http.server.Request) http.server.Response {
    c := num(http.server.Param(r, "count"))
    n := if c < 0 { 0 } else if c > len(ds) { len(ds) } else { c }
    m0 := num(http.server.Query(r, "m"))
    m := if m0 == 0 { 1 } else { m0 }
    mut out := mut []Processed{}
    for i <- iter.Range(0, n) {
        d := ds[i]
        out = append(out, Processed{id: d.id, name: d.name, category: d.category, price: d.price, quantity: d.quantity, active: d.active, tags: d.tags, rating: d.rating, total: d.price * d.quantity * m})
    }
    return http.server.Json(json.Encode[Body](Body{items: freeze(out), count: n}))
}

func baseline(r http.server.Request) http.server.Response {
    body := if r.method == "POST" { num(string(r.body) catch "") } else { 0 }
    return http.server.Text(convert.FormatInt(num(http.server.Query(r, "a")) + num(http.server.Query(r, "b")) + body))
}

func echo(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "application/octet-stream", body: r.body}
}

const maxBody = 131072

func delay(r http.server.Request) http.server.Response {
    ms := num(http.server.Param(r, "ms"))
    return http.server.Delayed(ms, http.server.Text(convert.FormatInt(ms)))
}

// /spec, the compliance route: GET answers a fixed body; HEAD needs no route of its own (Dispatch falls back from HEAD to
// the GET row and ServeConn drops the body); POST is the same echo as /echo; OPTIONS answers 200 with Allow
func specText(r http.server.Request) http.server.Response {
    return http.server.Text("spec ok")
}

func specOptions(r http.server.Request) http.server.Response {
    return http.server.Response{status: 200, contentType: "", body: []byte{}, headers: http.server.Headers{list: []http.Field{http.Field{name: "Allow", value: "GET, HEAD, POST, OPTIONS"}}}}
}

// /spec/headers: every request header, one "name: value" line each (names in lower case; the credential headers are
// left out, as http.server.HeaderList leaves them out). A body, if one is sent, is already read by ServeConn
func specHeaders(r http.server.Request) http.server.Response {
    mut lines := mut []string{}
    for f <- http.server.HeaderList(r) {
        lines = append(lines, "${f.name}: ${f.value}\n")
    }
    return http.server.Text(strings.Join(freeze(lines), ""))
}

// /parse, the resilience suite's parser endpoint: the body goes through the standard parser its Content-Type names
// (JSON → json.Parse, a form → url.ParseQuery, multipart → http.server.Multipart). A body in a Content-Encoding (gzip /
// deflate) is decoded first, its output capped at maxBody like a plain body (the zlib checksum of deflate is not checked). 200 when it parses, 400 when it does not, 413
// when the decoded body is over the cap, 415 for an encoding the server does not decode
func parse(r http.server.Request) http.server.Response {
    enc := field(r, "content-encoding")
    if enc != "" && enc != "identity" {
        if enc != "gzip" && enc != "x-gzip" && enc != "deflate" {
            return http.server.Status(http.StatusCode(415))
        }
        if enc == "deflate" {
            // the deflate coding is the zlib format (RFC 9110 8.4.1.2): a 2-byte header, the DEFLATE data, a 4-byte Adler-32
            z := r.body
            if len(z) < 6 || int(z[0]) % 16 != 8 || (int(z[0]) * 256 + int(z[1])) % 31 != 0 || int(z[1]) / 32 % 2 != 0 {
                return http.server.Status(http.BadRequest)
            }
            b, e := compress.flate.Decode(z[2:len(z) - 4], maxSize: maxBody)
            return decoded(mediaType(r), b, e)
        }
        b, e := compress.gzip.Decode(r.body, maxSize: maxBody)
        return decoded(mediaType(r), b, e)
    }
    mt := mediaType(r)
    if mt == "multipart/form-data" {
        _ := http.server.Multipart(r) catch return http.server.Status(http.BadRequest)
        return http.server.Text("ok")
    }
    return parsed(mt, r.body)
}

func decoded(mt string, b []byte, e error?) http.server.Response {
    return switch e {
    case nil: parsed(mt, b)
    case compress.flate.TooLarge{}: http.server.Status(http.ContentTooLarge)
    default: http.server.Status(http.BadRequest)
    }
}

// A request header's value, lower case and trimmed ("" when absent)
func field(r http.server.Request, name string) string {
    v := http.server.Header(r, name)
    if v == nil {
        return ""
    }
    return strings.ToLower(strings.TrimSpace(v))
}

// The media type of the request, lower case, without its parameters
func mediaType(r http.server.Request) string {
    mt, _, _ := strings.Cut(field(r, "content-type"), ";")
    return strings.TrimSpace(mt)
}

// JSON and form bodies are parsed; any other type is only buffered (a multipart body that came in a Content-Encoding too)
func parsed(mt string, b []byte) http.server.Response {
    if mt == "application/json" {
        _ := json.Parse(b) catch return http.server.Status(http.BadRequest)
    } else if mt == "application/x-www-form-urlencoded" {
        q := string(b) catch return http.server.Status(http.BadRequest)
        _ := url.ParseQuery(q) catch return http.server.Status(http.BadRequest)
    }
    return http.server.Text("ok")
}

func routes(ds []Item) []http.server.Route {
    none := []http.server.Middleware{}
    return []http.server.Route{
        http.server.Route{method: "GET", path: "/pipeline", handler: (r) => http.server.Text("ok"), middleware: none},
        http.server.Route{method: "GET", path: "/baseline11", handler: baseline, middleware: none},
        http.server.Route{method: "POST", path: "/baseline11", handler: baseline, middleware: none},
        http.server.Route{method: "GET", path: "/baseline2", handler: baseline, middleware: none},
        http.server.Route{method: "GET", path: "/delay/:ms", handler: delay, middleware: none},
        http.server.Route{method: "GET", path: "/json/:count", handler: (r) => items(ds, r), middleware: none, cache: http.server.Unstated{}},
        http.server.Route{method: "POST", path: "/echo", handler: echo, middleware: none},
        http.server.Route{method: "POST", path: "/parse", handler: parse, middleware: none},
        http.server.Route{method: "GET", path: "/spec", handler: specText, middleware: none},
        http.server.Route{method: "OPTIONS", path: "/spec", handler: specOptions, middleware: none},
        http.server.Route{method: "POST", path: "/spec", handler: echo, middleware: none},
        http.server.Route{method: "GET", path: "/spec/headers", handler: specHeaders, middleware: none},
        http.server.Route{method: "POST", path: "/spec/headers", handler: specHeaders, middleware: none},
        http.server.Route{method: "GET", path: "/async-db", handler: (r) => http.server.Json(noRows), middleware: none},
    }
}

func certs() tls.Config? {
    c, _ := os.Getenv("TLS_CERT")
    k, _ := os.Getenv("TLS_KEY")
    cfg, e := tls.Load(if c != nil { c } else { "/certs/server.crt" }, if k != nil { k } else { "/certs/server.key" })
    if e != nil {
        return nil
    }
    return cfg
}

func serveTls(ds []Item, cfg tls.Config, tport string) int {
    _ = io.WriteStdout(bytes("tls-ready ${tport}\n"))
    e := tls.Serve("0.0.0.0:${tport}", cfg, (c net.Conn) => serveTlsConn(ds, c))
    return if e != nil { 1 } else { 0 }
}

// the route table is built per request: a lambda kept as a value (the tls.Handler) cannot capture the table (it holds function values),
// and a table built per connection would stay in the connection task's region while it waits (one page per waiting connection)
func serveTlsConn(ds []Item, c net.Conn) error? {
    return http.server.ServeConn(c, (r http.server.Request) => http.server.Dispatch(routes(ds), r), maxBody: maxBody)
}

const noRows = "{\"items\":[],\"count\":0}"

const itemsSql = "SELECT id, name, category, price, quantity, active, tags, rating_score, rating_count FROM items WHERE price BETWEEN $1 AND $2 LIMIT $3"

// GET /async-db?min=&max=&limit= (defaults 10 / 50 / 50, limit clamped to 1..50)
func asyncDb(p pg.Pool, r http.server.Request) http.server.Response {
    lo := numOr(http.server.Query(r, "min"), 10)
    hi := numOr(http.server.Query(r, "max"), 50)
    l := numOr(http.server.Query(r, "limit"), 50)
    lim := if l < 1 { 1 } else if l > 50 { 50 } else { l }
    mut body := noRows
    e := pg.With(p, (c) => {
        body = itemsJson(c, lo, hi, lim) catch noRows
    })
    return http.server.Json(if e != nil { noRows } else { body })
}

func numOr(s string?, d int) int {
    if s == nil {
        return d
    }
    return convert.ParseInt(s) catch d
}

// the rows as the response body (tags is the JSONB text as Postgres sends it; rating_* fold into rating)
func itemsJson(c pg.Conn, lo int, hi int, lim int) (string, error?) {
    mut o := builder.Builder[byte]{}
    json.Put(mut o, "{\"items\":[")
    mut n := 0
    for row <- pg.Query(c, itemsSql, args: []pg.Value{pg.Int{v: lo}, pg.Int{v: hi}, pg.Int{v: lim}})? {
        json.Put(mut o, if n == 0 { "{\"id\":" } else { ",{\"id\":" })
        json.PutInt(mut o, pg.ColInt(row, 0)?)
        json.Put(mut o, ",\"name\":")
        json.PutString(mut o, pg.ColString(row, 1)?)
        json.Put(mut o, ",\"category\":")
        json.PutString(mut o, pg.ColString(row, 2)?)
        json.Put(mut o, ",\"price\":")
        json.PutInt(mut o, pg.ColInt(row, 3)?)
        json.Put(mut o, ",\"quantity\":")
        json.PutInt(mut o, pg.ColInt(row, 4)?)
        json.Put(mut o, ",\"active\":")
        json.PutBool(mut o, pg.ColBool(row, 5)?)
        json.Put(mut o, ",\"tags\":")
        json.Put(mut o, pg.ColJsonText(row, 6)?)
        json.Put(mut o, ",\"rating\":{\"score\":")
        json.PutInt(mut o, pg.ColInt(row, 7)?)
        json.Put(mut o, ",\"count\":")
        json.PutInt(mut o, pg.ColInt(row, 8)?)
        json.Put(mut o, "}}")
        n += 1
    }
    json.Put(mut o, "],\"count\":")
    json.PutInt(mut o, n)
    json.Put(mut o, "}")
    return json.Done(mut o), nil
}

// DATABASE_URL carries the password (postgres://user:pass@host:port/db); std/pg takes it apart: the URL without it, and the password
func splitUrl(u string) (string, string) {
    scheme, rest, ok := strings.Cut(u, "://")
    auth, hostpath, hasAt := strings.CutLast(rest, "@")
    if !ok || !hasAt {
        return u, ""
    }
    user, pw, hasPw := strings.Cut(auth, ":")
    if !hasPw {
        return u, ""
    }
    return "${scheme}://${user}@${hostpath}", url.Unescape(pw) catch pw
}

// pool size = DATABASE_MAX_CONN less a few for the harness's own psql / pg_isready (default 256)
func poolSize() int {
    m := numOr(os.Getenv("DATABASE_MAX_CONN") catch nil, 256)
    return if m > 16 { m - 6 } else if m > 1 { m - 1 } else { 1 }
}

func run(port string, tport string, h2port string) int {
    ds := load()
    gzw := task.NewLocal((w mut compress.flate.Work) => compress.flate.NewWork(mut w))
    cfg := certs()
    u := os.Getenv("DATABASE_URL") catch nil
    if u != nil {
        at, pw := splitUrl(u)
        mut rc := -1
        oe := pg.OpenPool(at, (p) => {
            rc = serveDb(ds, gzw, cfg, port, tport, h2port, p)
        }, size: poolSize(), policy: pg.Policy{password: pw, dangerouslyPlaintext: true})
        if oe == nil && rc >= 0 {
            return rc
        }
    }
    pe, se := task.Run((s task.Scope) => {
        if cfg != nil {
            _ = task.Spawn(s, () => serveTls(ds, cfg, tport))
        }
        _ = task.Spawn(s, () => if h2c(routes(ds), gzw, h2port) == nil { 0 } else { 1 })
        plain(routes(ds), gzw, port)
    })
    return if se != nil || pe != nil { 1 } else { 0 }
}

// HTTP/2 with prior knowledge (h2c) on the third port: the same routes, ServeConn with proto: H2 (the baseline-h2c and json-h2c profiles)
func h2c(rs []http.server.Route, gzw task.Local, port string) error? {
    for l <- net.Listen("0.0.0.0:${port}")? {
        io.WriteStdout(bytes("h2c-ready ${net.Port(l)}\n"))?
        net.Serve(l, (c net.Conn) => http.server.ServeConn(c, (r http.server.Request) => http.server.Dispatch(rs, r), maxBody: maxBody, compression: http.server.Gzip{}, work: gzw, proto: http.server.H2), conns: 1100000)?
    }
    return nil
}

func plain(rs []http.server.Route, gzw task.Local, port string) error? {
    for l <- net.Listen("0.0.0.0:${port}")? {
        io.WriteStdout(bytes("ready ${net.Port(l)}\n"))?
        net.Serve(l, (c net.Conn) => http.server.ServeConn(c, (r http.server.Request) => http.server.Dispatch(rs, r), maxBody: maxBody, compression: http.server.Gzip{}, work: gzw), conns: 1100000)?
    }
    return nil
}

// With DATABASE_URL: the plain port answers /async-db from the pool p (a handler kept in the route table or behind
// tls.Serve cannot capture the pool, so those answer the empty body). Without it the server is run / plain above, unchanged
func serveDb(ds []Item, gzw task.Local, cfg tls.Config?, port string, tport string, h2port string, p pg.Pool) int {
    pe, se := task.Run((s task.Scope) => {
        if cfg != nil {
            _ = task.Spawn(s, () => serveTls(ds, cfg, tport))
        }
        _ = task.Spawn(s, () => if h2c(routes(ds), gzw, h2port) == nil { 0 } else { 1 })
        plainDb(routes(ds), gzw, port, p)
    })
    return if se != nil || pe != nil { 1 } else { 0 }
}

func plainDb(rs []http.server.Route, gzw task.Local, port string, p pg.Pool) error? {
    for l <- net.Listen("0.0.0.0:${port}")? {
        io.WriteStdout(bytes("ready ${net.Port(l)}\n"))?
        net.Serve(l, (c net.Conn) => http.server.ServeConn(c, (r http.server.Request) => if r.path == "/async-db" && r.method == "GET" { asyncDb(p, r) } else { http.server.Dispatch(rs, r) }, maxBody: maxBody, compression: http.server.Gzip{}, work: gzw), conns: 1100000)?
    }
    return nil
}

func main() int {
    args := os.Args() catch return 2
    if len(args) > 4 {
        return 2
    }
    return run(if len(args) >= 2 { args[1] } else { "8080" }, if len(args) >= 3 { args[2] } else { "8081" }, if len(args) == 4 { args[3] } else { "8082" })
}

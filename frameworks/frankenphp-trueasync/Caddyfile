{
	admin off
	auto_https off
	frankenphp

	# json-tls and static-tls want HTTP/1.1 negotiated and no h2 offered; :8443
	# keeps the default set for the h2 profiles.
	servers :8081 {
		protocols h1
	}
}

:8080 {
	encode br gzip
	root * /app
	php_server {
		index off
		file_server off
		worker {
			file /app/worker.php
			num {$WORKERS:0}
			async
			buffer_size 1
			match /*
		}
	}
}

:8443 {
	tls /certs/server.crt /certs/server.key
	root * /app
	php_server {
		index off
		file_server off
		worker {
			file /app/worker.php
			num {$WORKERS:0}
			async
			buffer_size 1
			match /*
		}
	}
}

# json-tls and static-tls: the same app over TLS, HTTP/1.1 only.
:8081 {
	encode br gzip
	tls /certs/server.crt /certs/server.key
	root * /app
	php_server {
		index off
		file_server off
		worker {
			file /app/worker.php
			num {$WORKERS:0}
			async
			buffer_size 1
			match /*
		}
	}
}

{
  "display_name": "genhttp-ioxide",
  "language": "C#",
  "type": "emerging",
  "mode": "standard",
  "completeness": {
    "routing": true,
    "middleware": true,
    "request": true,
    "response": true
  },
  "engine": "ioxide",
  "description": "GenHTTP, the modular C# web server, running on ioxide: an io_uring, thread-per-core runtime that plugs in as GenHTTP's server engine in place of the default socket engine. GenHTTP provides routing, serialization and its modules; ioxide owns the connections, TLS, HTTP/2 and HTTP/3, with Postgres access on the same ring through ioxide.pg.",
  "repo": "https://github.com/Kaliumhexacyanoferrat/GenHTTP",
  "website": "https://genhttp.org/documentation/server/engines/ioxide/",
  "enabled": true,
  "spec": ["h1", "h2", "h3", "ws"],
  "tests": [
    "baseline",
    "async",
    "latency-1m",
    "connections-5m",
    "connections-1m-tls",
    "connections-1m",
    "latency-10k", 
    "pipelined",
    "limited-conn",
    "json-comp",
    "json-tls",
    "static-tls",
    "baseline-h2c",
    "json-h2c",
    "baseline-h2",
    "static-h2",
    "static-h3",
    "baseline-h3",
    "8gbit",
    "async-db",
    "echo-ws",
    "echo-ws-pipeline",
    "echo-ws-limited"
  ],
  "maintainers": [
    "MDA2AV"
  ]
}

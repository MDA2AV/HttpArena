<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds the vendored feed alongside whatever sources the SDK image already has,
  so ioxide resolves to the build in localfeed/ while every other package still
  comes from nuget.org. Temporary: it exists to measure IORING_OP_TIMEOUT on the
  bench hardware before the API is released, and goes away with the answer.
-->
<configuration>
  <packageSources>
    <add key="local" value="localfeed" />
  </packageSources>
</configuration>

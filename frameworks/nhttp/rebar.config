{erl_opts, [debug_info]}.

{minimum_otp_vsn, "27"}.

{deps, [{nhttp, "1.4.0"}]}.

{relx, [
    {release, {nhttp_httparena, "0.1.0"}, [nhttp_httparena]},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [{mode, prod}]}
    ]}
]}.

diff --git a/src/reactor/stream.c b/src/reactor/stream.c
index d468503..d429b40 100644
--- a/src/reactor/stream.c
+++ b/src/reactor/stream.c
@@ -113,6 +113,12 @@ static void stream_update(stream_t *stream)
     stream->output_flushed = 0;
     stream_output(stream);
   }
+  else if (stream->close_on_drain && buffer_size(&stream->output_waiting) == 0)
+  {
+    /* every queued byte has reached the socket and a graceful close was requested: signal close
+     * now (unlike stream_close, which is abortive and would drop unsent output) */
+    reactor_call(&stream->user, STREAM_CLOSE, 0);
+  }
   else if (!stream->read && (!stream->flags & STREAM_WRITE_ONLY))
   {
     stream_input(stream);
@@ -205,3 +211,9 @@ void stream_flush(stream_t *stream)
   stream->output_flushed = buffer_size(&stream->output_waiting);
   stream_update(stream);
 }
+
+void stream_close_on_drain(stream_t *stream)
+{
+  stream->close_on_drain = true;
+  stream_update(stream);
+}
diff --git a/src/reactor/stream.h b/src/reactor/stream.h
index 9fea614..0878510 100644
--- a/src/reactor/stream.h
+++ b/src/reactor/stream.h
@@ -37,6 +37,7 @@ struct stream
   buffer_t        output_writing;
   buffer_t        output_waiting;
   size_t          output_flushed;
+  bool            close_on_drain;
 };
 
 void    stream_construct(stream_t *, reactor_callback_t *, void *);
@@ -50,5 +51,6 @@ void    stream_consume(stream_t *, size_t);
 void   *stream_allocate(stream_t *, size_t);
 void    stream_write(stream_t *, data_t);
 void    stream_flush(stream_t *);
+void    stream_close_on_drain(stream_t *);
 
 #endif /* REACTOR_STREAM_H_INCLUDED */

  "enabled": true,
  "tls_check": true,
  "tests": [
    "baseline", "latency-1m", "latency-10k",
    "pipelined",
    "limited-conn",
    "async",
    "json-comp",
    "8gbit",
    "async-db",
    "static-tls",
    "echo-ws",
    "echo-ws-pipeline",
    "echo-ws-limited",
    "json-tls",
    "gateway-64",
    "gateway-h3",
    "production-stack",
    "fortunes"
  ],
  "maintainers": [
    "nigrosimone"
  ]

  "enabled": true,
  "tests": [
    "baseline",
    "pipelined",
    "limited-conn",
    "async",
    "latency-1m",
    "latency-10k",
    "latency-500k-8cpu",
    "json-comp",
    "json-tls",
    "8gbit",
    "static-tls",
    "baseline-h2",
    "static-h2",
    "baseline-h2c",
    "json-h2c",
    "baseline-h3",
    "static-h3",
    "unary-grpc",
    "unary-grpc-tls",
    "echo-ws",
    "echo-ws-pipeline",
    "echo-ws-limited",
    "gateway-64",
    "gateway-h3",
    "production-stack"
  ],
  "maintainers": [
    "xuckless"
  ]
}

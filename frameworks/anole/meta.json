{
  "display_name": "anole",
  "language": "Zig",
  "type": "emerging",
  "mode": "standard",
  "completeness": {
    "routing": true,
    "middleware": true,
    "request": true,
    "response": true
  },
  "engine": "zio",
  "description": "Anole: HTTP/1.1, HTTP/2, HTTP/3, WebSocket, gRPC and WebTransport on the zio async runtime (io_uring where available, epoll fallback), BoringSSL. Documented APIs and default settings.",

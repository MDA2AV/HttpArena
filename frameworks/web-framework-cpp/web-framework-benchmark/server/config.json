{
  "WebServer": {
    "ip": "0.0.0.0",
    "port": 8080,
    "timeout": 30000
  },
  "WebFramework": {
    "assetsPath": "/data",
    "templatesPath": "templates",
    "webServerType": "threadPool",
    "settingsPaths": [ "web.json" ],
    "loadSources": [ "executors" ],
    "HTTPS": {
      "pathToCertificate": "/certs/server.crt",
      "pathToKey": "/certs/server.key",
      "useHTTPS": false
    }
  },
  "ThreadPoolServer": {
    "threadCount": 8
  }
}
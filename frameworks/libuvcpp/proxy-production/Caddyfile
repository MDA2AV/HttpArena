# libuvcpp production-stack edge.
#
# Same stock Caddy as the gateway edge, with the three-way path split the
# production-stack profile defines:
#
#   /static/*   served here from disk, never reaching the server
#   /public/*   forwarded unauthenticated
#   /api/*      forwarded only after authsvc has verified the bearer token
#
# forward_auth fires a subrequest to the shared authsvc on every /api/* call and
# nothing caches it: the HMAC-SHA256 that costs is part of what the profile
# measures. What the server receives is the X-User-Id authsvc resolved, never
# the Authorization header -- the profile's rules put JWT verification at the
# edge and forbid the framework from doing it, and the server separately
# refuses any /api/* request that arrives with no X-User-Id at all.
#
# Both upstreams name 127.0.0.1:8085 -- the compose `server` service's H1_PORT,
# not the 8080 the entry uses when it runs alone. The server binds its ports at
# startup and exits if a bind fails, and this stack is on the host network, so
# the backend is given ports of its own; see compose.gateway.yml.
{
	admin off
	auto_https off
	servers {
		protocols h1 h2
	}
}

https://localhost:8443 {
	tls /certs/server.crt /certs/server.key

	handle /static/* {
		root * /data
		file_server {
			precompressed br gzip
		}
	}

	handle /public/* {
		reverse_proxy 127.0.0.1:8085 {
			transport http {
				versions 1.1
				keepalive 5m
				keepalive_idle_conns 2048
				keepalive_idle_conns_per_host 2048
			}
		}
	}

	# authsvc answers 200 + X-User-Id or 401, and forward_auth returns its
	# refusal verbatim, so an unauthenticated /api/* never reaches the server.
	handle /api/* {
		forward_auth 127.0.0.1:9090 {
			uri /_auth
			copy_headers X-User-Id
		}
		reverse_proxy 127.0.0.1:8085 {
			transport http {
				versions 1.1
				keepalive 5m
				keepalive_idle_conns 2048
				keepalive_idle_conns_per_host 2048
			}
		}
	}
}

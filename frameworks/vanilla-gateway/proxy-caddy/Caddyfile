# vanilla gateway-h3 edge.
#
# Stock Caddy terminates TLS and h3 on 8443, serves /static/* from disk and
# forwards the dynamic endpoints to the vanilla-epoll server on loopback.
{
	admin off
	auto_https off
	servers {
		protocols h1 h2 h3
	}
}

https://localhost:8443 {
	tls /certs/server.crt /certs/server.key

	# served from disk by the proxy; precompressed prefers the .br / .gz
	# sidecars per Accept-Encoding (root /data + /static/foo -> /data/static/foo)
	handle /static/* {
		root * /data
		file_server {
			precompressed br gzip
		}
	}

	# /baseline2, /json, /async-db: plain HTTP/1.1 with a large keepalive pool,
	# so streams multiplexed over one QUIC connection fan out across the
	# server's workers
	handle {
		reverse_proxy 127.0.0.1:8080 {
			transport http {
				versions 1.1
				keepalive 5m
				keepalive_idle_conns 2048
				keepalive_idle_conns_per_host 2048
			}
		}
	}
}

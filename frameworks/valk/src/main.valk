use valk.core
use valk.fs
use valk.http
use valk.json
use valk.thread
use valk.time

struct Rating {
    score: int
    count: int
}

struct Item {
    id: int
    name: String
    category: String
    price: int
    quantity: int
    active: bool
    tags: Array[String]
    rating: Rating
}

struct Total {
    id: int
    name: String
    category: String
    price: int
    quantity: int
    active: bool
    tags: Array[String]
    rating: Rating
    total: int
}

struct Page {
    items: Array[Total]
    count: int
}

type Handler (fn(http.Request)(http.Response))

global thread_dataset: ?Array[Item] (null)
global current_route: ?http.Route[Handler] (null)
global h1_routes: ?http.Router[Handler] (null)
global h1_tls_routes: ?http.Router[Handler] (null)
global h2_routes: ?http.Router[Handler] (null)
global h2c_routes: ?http.Router[Handler] (null)

fn dataset() Array[Item] {
    let d = thread_dataset
    if isset(d) : return d
    let path = core.getenv("DATASET_PATH") !? "/data/dataset.json"
    let text = fs.read(path) !? "[]"
    let loaded = json.decode_to[Array[Item]](text) !? Array[Item].new()
    thread_dataset = loaded
    return loaded
}

fn route_param(req: http.Request, name: String) ?String {
    let route = current_route ?! return null
    return route.param(req.path, name) !? null
}

fn dispatch(router: http.Router[Handler], req: http.Request) http.Response {
    let route = router.find(req.method, req.path) ! return http.Response.text("not found", 404)
    current_route = route
    return (route.handler)(req)
}

fn baseline(req: http.Request) http.Response {
    let a = (req.query_param("a") !? "0").to_int() !? 0
    let b = (req.query_param("b") !? "0").to_int() !? 0
    let sum = a + b
    if req.method == "POST" : sum += req.body.trim().to_int() !? 0
    return http.Response.text(sum.to_string())
}

fn pipeline(req: http.Request) http.Response {
    return http.Response.text("ok")
}

fn delay(req: http.Request) http.Response {
    let raw = route_param(req, "ms") ?? "0"
    let ms = raw.to_uint() !? 0
    if ms > 0 : time.sleep_ms(ms)
    return http.Response.text(ms.to_string())
}

fn json_items(req: http.Request) http.Response {
    let raw = route_param(req, "count") ?! return http.Response.text("bad request", 400)
    let count = raw.to_int() ! return http.Response.text("bad request", 400)
    let m = (req.query_param("m") !? "1").to_int() !? 1
    let items = dataset()
    let n = count
    if n < 0 : n = 0
    if n > items.length.to(int) : n = items.length.to(int)
    let totals = Array[Total].new(n.to(uint))
    each 0 .. n.to(uint) as i {
        let d = items[i]
        totals.append(Total {
            id: d.id
            name: d.name
            category: d.category
            price: d.price
            quantity: d.quantity
            active: d.active
            tags: d.tags
            rating: d.rating
            total: d.price * d.quantity * m
        })
    }
    return http.Response.json_of(Page { items: totals, count: n })
}

fn echo_body(req: http.Request) http.Response {
    return http.Response.new(req.body, 200, "application/octet-stream")
}

fn ws_echo(req: http.Request) http.Response {
    return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
        while true {
            let msg = ws.read() ! break
            if msg.is_text : ws.write(msg.data) ! break
            else : ws.write_binary(msg.data) ! break
        }
    })
}

fn handle_h1(req: http.Request) http.Response {
    let r = h1_routes ?? <{
        let built = http.Router[Handler].new()
        built.add("GET", "/baseline11", baseline)
        built.add("POST", "/baseline11", baseline)
        built.add("GET", "/pipeline", pipeline)
        built.add("GET", "/delay/@ms", delay)
        built.add("GET", "/json/@count", json_items)
        built.add("GET", "/ws", ws_echo)
        h1_routes = built
        return built
    }
    return dispatch(r, req)
}

fn handle_h1_tls(req: http.Request) http.Response {
    let r = h1_tls_routes ?? <{
        let built = http.Router[Handler].new()
        built.add("GET", "/json/@count", json_items)
        built.add("POST", "/echo", echo_body)
        h1_tls_routes = built
        return built
    }
    return dispatch(r, req)
}

fn handle_h2(req: http.Request) http.Response {
    let r = h2_routes ?? <{
        let built = http.Router[Handler].new()
        built.add("GET", "/baseline2", baseline)
        built.add("POST", "/baseline2", baseline)
        h2_routes = built
        return built
    }
    return dispatch(r, req)
}

fn handle_h2c(req: http.Request) http.Response {
    let r = h2c_routes ?? <{
        let built = http.Router[Handler].new()
        built.add("GET", "/baseline2", baseline)
        built.add("POST", "/baseline2", baseline)
        built.add("GET", "/json/@count", json_items)
        h2c_routes = built
        return built
    }
    return dispatch(r, req)
}

fn start_h2c() {
    let h2c = http.Server.new("0.0.0.0", 8082, handle_h2c)
    h2c.http2 = true
    h2c.reuse_port = true
    h2c.start() ! panic("Failed to start h2c server on port 8082")
}

fn start_h1_tls(cert_path: String, key_path: String, static_dir: String) {
    let h1_tls = http.Server.new("0.0.0.0", 8081, handle_h1_tls)
    h1_tls.tls(cert_path, key_path) ! panic("Failed to configure TLS on port 8081")
    h1_tls.compress = true
    h1_tls.reuse_port = true
    if fs.is_dir(static_dir) : h1_tls.add_static_dir(static_dir, "", "/static") ! {}
    h1_tls.start() ! panic("Failed to start HTTPS server on port 8081")
}

fn start_h2_tls(cert_path: String, key_path: String, static_dir: String) {
    let h2_tls = http.Server.new("0.0.0.0", 8443, handle_h2)
    h2_tls.tls(cert_path, key_path) ! panic("Failed to configure TLS on port 8443")
    h2_tls.http2 = true
    h2_tls.compress = true
    h2_tls.reuse_port = true
    if fs.is_dir(static_dir) : h2_tls.add_static_dir(static_dir, "", "/static") ! {}
    h2_tls.start() ! panic("Failed to start HTTP/2 TLS server on port 8443")
}

fn main() {
    let cert_path = core.getenv("TLS_CERT") !? "/certs/server.crt"
    let key_path = core.getenv("TLS_KEY") !? "/certs/server.key"
    let static_dir = core.getenv("STATIC_DIR") !? "/data/static"

    thread.Thread[void].start(start_h2c) ! panic("Failed to spawn h2c listener")

    if fs.is_file(cert_path) && fs.is_file(key_path) {
        let run_h1_tls: atomic fn()() = fn() { start_h1_tls(cert_path, key_path, static_dir) }
        let run_h2_tls: atomic fn()() = fn() { start_h2_tls(cert_path, key_path, static_dir) }
        thread.Thread[void].start(run_h1_tls) ! panic("Failed to spawn HTTPS listener")
        thread.Thread[void].start(run_h2_tls) ! panic("Failed to spawn HTTP/2 TLS listener")
    }

    let server = http.Server.new("0.0.0.0", 8080, handle_h1)
    server.compress = true
    server.reuse_port = true
    server.start() ! panic("Failed to start HTTP server on port 8080")
}
